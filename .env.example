# Keep real values in .env.local and Vercel Environment Variables.
ADMIN_TOKEN=

# Keep the URL secret-free. The server appends ?secret-key= at runtime.
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
SELLERSPRITE_SECRET_KEY=YOUR_SELLERSPRITE_KEY

# Sif receives the key in both its query string and secret-key header.
SIF_MCP_URL=https://mcp.sif.com/mcp
SIF_SECRET_KEY=YOUR_SIF_KEY
SIF_AUTH_HEADER=secret-key
SIF_AUTH_SCHEME=
SIF_TRANSPORT=streamable-http

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=

# Reserved for a later scheduled endpoint.
CRON_SECRET=
